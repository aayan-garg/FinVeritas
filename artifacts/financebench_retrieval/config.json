{
  "dataset": "FinanceBench (Open Source 150-Question Sample)",
  "sources": {
    "huggingface": "https://huggingface.co/datasets/PatronusAI/financebench",
    "github": "https://github.com/patronus-ai/financebench"
  },
  "license": "CC BY-NC 4.0",
  "top_k_ranks": [
    1,
    3,
    5
  ],
  "pdf_parser": "pypdf",
  "corpus_scope": {
    "target_documents": 84,
    "parsed_documents": 84,
    "total_pages": 12013
  },
  "models": {
    "tfidf": {
      "ngram_range": [
        1,
        2
      ],
      "min_df": 2,
      "similarity": "cosine"
    },
    "bm25": {
      "k1": 1.5,
      "b": 0.75,
      "algorithm": "Okapi BM25"
    }
  },
  "disclaimer": "Retrieval evaluation measures surface page-level evidence locating. It does not evaluate numerical reasoning or answer generation correctness."
}