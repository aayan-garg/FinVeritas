# FinVeritas Environment Configuration Example
# Copy to .env and configure local settings

# SEC EDGAR API Configuration (Required by SEC: User-Agent format: 'Name AdminContact@domain.com')
SEC_EDGAR_USER_AGENT=FinVeritasAdmin admin@finveritas.local

# Hugging Face Token (optional)
HF_TOKEN=

# Model Execution
FINVERITAS_DEVICE=cuda
FINVERITAS_CACHE_DIR=./data/interim

# Logging
LOG_LEVEL=INFO
